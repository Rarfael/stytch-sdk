              }
            ]
          }
          method: "PUT"
          orig: "/users/{user_id}"
          parts: [
            "users"
            "{id}"
          ]
          rename: {
            param: {
              user_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
