# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 5

  entity: user: {
    path: "/users": {
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/users/{user_id}": {
      rename: param: "user_id": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
  }

}